# ─────────────────────────────────────────────────────────────
# .env.example — SAFE TO COMMIT (template only, no real secrets)
# Copy to .env and fill in real values:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase — shared by WSL + Mac) ─────────────────
# Get this from: Supabase Dashboard → Project Settings → Database
#   → Connection string → URI → "Session pooler" (port 5432).
# Use the database password (NOT your account login password).
# Use letters+numbers only, or URL-encode special characters.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-YOUR_REGION.pooler.supabase.com:5432/postgres

# ── Local Postgres fallback (only used with --profile local-db) ─
# Run fully offline with: docker-compose --profile local-db up -d
# then set DATABASE_URL above to:
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
POSTGRES_DB=scriptedlines_db
POSTGRES_USER=scriptedlines_user
POSTGRES_PASSWORD=your_local_db_password

# ── JWT Authentication (Phase 0) ──────────────────────────────
# Generate a strong random value, e.g.:  openssl rand -hex 32
JWT_SECRET_KEY=generate_a_long_random_secret_here

# ── Environment ───────────────────────────────────────────────
ENV=development
