# ─────────────────────────────────────────────────────────────
# .env.example
# Copy this file to .env and fill in the values.
# .env is gitignored — NEVER commit it.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=scriptedlines_db
POSTGRES_USER=scriptedlines_user
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── JWT Authentication (Phase 0) ──────────────────────────────
# Generate a strong secret: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ── Environment ───────────────────────────────────────────────
ENV=development
