# Database dumps — never commit these. They contain the full schema,
# including users.password_hash, and (once seeded) real customer data.
# Both dev machines point at the shared Supabase DB directly (see .env),
# so there's no need to sync a dump through git at all.
data/backups/*.bak
backend/storage/
!backend/storage/.gitkeep

# Test login credentials — even test-only passwords shouldn't land in git.
data/test_login_credentials.txt
